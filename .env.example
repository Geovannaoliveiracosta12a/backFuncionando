# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env real NAO deve ser versionado (esta no .gitignore).

# Porta do servidor backend
PORT=5000

# Limiares de classificacao do nivel da agua
NIVEL_ATENCAO=1000
NIVEL_PERIGO=2000
NIVEL_CRITICO=3000

# Limites de armazenamento (quantidade maxima de registros)
MAX_LEITURAS=1000
MAX_ALARMES=500

# Localizacao usada na previsao meteorologica (Open-Meteo)
LATITUDE=-23.5505
LONGITUDE=-46.6333
